# Anthropic (Claude) API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-5-20251101
CLAUDE_VISION_MODEL=claude-opus-4-5-20251101

# App
APP_NAME=Huddlebiz
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (SQLite)
DATABASE_URL=sqlite:///./data/huddlebiz.db

# Session
SESSION_TTL_DAYS=30

# Backend AI Integration
BACKEND_API_URL=https://huddlebiz-api.softvenceomegaforce.cloud
AI_SERVICE_TOKEN=your_ai_service_token_here
